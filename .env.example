# Local development defaults to FastAPI at 127.0.0.1:8001 when blank.
# Production builds require an explicit public HTTPS API URL.
VITE_API_BASE_URL=

# Assistant abuse protection. Local development uses bounded process-local memory.
APP_ENV=development
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_IP_PER_MINUTE=30
RATE_LIMIT_USER_PER_MINUTE=6
RATE_LIMIT_USER_PER_DAY=50
RATE_LIMIT_USER_CONCURRENCY=2
ASSISTANT_MAX_BODY_BYTES=131072
ASSISTANT_TOTAL_TIMEOUT_SECONDS=55

# Production only: configure a private Redis-compatible URL. Render production
# requires one valid cf-connecting-ip header; X-Forwarded-For is never trusted.
REDIS_URL=

# Backend-only Adzuna credentials. Do not use VITE_ prefixes for secrets.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Backend publishable API key used only to validate legacy test-project sessions.
SUPABASE_PUBLISHABLE_KEY=

# Backend Supabase Auth project URL. Required in production; development falls
# back to the existing Kaam-Calm project when this is blank.
SUPABASE_URL=

# Backend-only Google Gemini API key. Never add a VITE_ prefix or commit a real key.
GEMINI_API_KEY=

# Optional backend model override. Defaults to gemini-3.5-flash-lite.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional comma-separated browser origins allowed by the backend in addition to
# the built-in local development and production frontend origins.
CORS_ORIGINS=

# Supabase browser configuration. Use only the project URL and publishable key,
# or the legacy anon key. Never put a secret/service-role key in VITE_ variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key alternative (leave blank if using the publishable key above).
VITE_SUPABASE_ANON_KEY=
