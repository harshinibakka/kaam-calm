# Optional frontend API URL. Defaults to the existing production API when blank.
VITE_API_BASE_URL=

# Backend-only Adzuna credentials. Do not use VITE_ prefixes for secrets.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional comma-separated browser origins allowed by the backend in addition to
# the built-in local development and production frontend origins.
CORS_ORIGINS=

# Supabase browser configuration. Use only the project URL and publishable key,
# or the legacy anon key. Never put a secret/service-role key in VITE_ variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key alternative (leave blank if using the publishable key above).
VITE_SUPABASE_ANON_KEY=
